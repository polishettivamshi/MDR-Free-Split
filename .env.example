# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SplitUPI Environment Variables
PORT=3000
ENVIRONMENT=development
JWT_SECRET=super_secret_splitupi_jwt_key_32chars_min
JWT_REFRESH_SECRET=super_secret_splitupi_refresh_key_32chars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splitupi
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# Payment Provider Configuration
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=mock_client_key_12345
PAYMENT_PROVIDER_SECRET=mock_client_secret_67890
WEBHOOK_SECRET=mock_webhook_secret_99999

# Public URLs
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

