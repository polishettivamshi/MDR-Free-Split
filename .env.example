# Optional: Google AdSense Publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
#
# This is a PUBLIC identifier, so the app already ships with a working default
# (see src/lib/adsense.ts). Set this variable only if you want to override the
# publisher ID without editing code — e.g. in Vercel → Project Settings →
# Environment Variables. The value must be a full `ca-pub-` ID; invalid values
# are ignored and the built-in default is used instead.
VITE_ADSENSE_PUBLISHER_ID=ca-pub-6633100438556373

# Optional: canonical site URL, used for the canonical link, Open Graph tags,
# JSON-LD, robots.txt and sitemap.xml. Defaults to
# https://mdr-free-split.vercel.app — set this once a custom domain is live.
VITE_SITE_URL=https://mdr-free-split.vercel.app
